+/*
+ * ============================================================================
+ * 49-bit API
+ * ============================================================================
+ */
+
+/* Unpack 7 left-aligned bytes into mbelib's one-bit-per-char array. */
+static void unpack_bits49(const uint8_t *in, char ambe_d[49])
+{
+    for (int i = 0; i < 49; i++)
+        ambe_d[i] = (in[i / 8] >> (7 - (i % 8))) & 1;
+}
+
+/* Pack mbelib's one-bit-per-char array into 7 left-aligned bytes. */
+static void pack_bits49(const uint8_t *bits, uint8_t *out)
+{
+    memset(out, 0, OPENDMR_AMBE49_BYTES);
+    for (int i = 0; i < 49; i++)
+        if (bits[i])
+            out[i / 8] |= (1 << (7 - (i % 8)));
+}
+
+bool opendmr_decode49(opendmr_decoder_t *dec,
+                      const uint8_t bits49[OPENDMR_AMBE49_BYTES],
+                      int16_t pcm[OPENDMR_PCM_SAMPLES],
+                      int *errs)
+{
+    if (!dec || !bits49 || !pcm)
+        return false;
+
+    char ambe_d[49];
+    unpack_bits49(bits49, ambe_d);
+
+    int err_count = 0;
+    int err_count2 = 0;
+    char err_str[64] = {0};
+
+    mbe_processAmbe2450Data(pcm, &err_count, &err_count2, err_str,
+                            ambe_d, &dec->cur_mp, &dec->prev_mp,
+                            &dec->prev_mp_enhanced, 3);
+
+    /* This path carries no FEC, so nothing can be corrected. Reported as zero
+       rather than left unset, so a caller reading it is not misled. */
+    if (errs)
+        *errs = 0;
+
+    return true;
+}
+
+bool opendmr_encode49(opendmr_encoder_t *enc,
+                      const int16_t pcm[OPENDMR_PCM_SAMPLES],
+                      uint8_t bits49[OPENDMR_AMBE49_BYTES])
+{
+    if (!enc || !enc->enc || !pcm || !bits49)
+        return false;
+
+    int b[9] = {0};
+    enc->enc->encode_dmr_params(pcm, b);
+
+    uint8_t bits[49];
+    params_to_bits49(b, bits);
+    pack_bits49(bits, bits49);
 
     return true;
 }
