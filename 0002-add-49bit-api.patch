+/*
+ * ============================================================================
+ * 49-bit API — what MOTOTRBO IPSC actually carries
+ * ============================================================================
+ *
+ * Over the air a DMR voice frame is 72 bits: 49 bits of vocoder parameters plus
+ * Golay FEC. The repeater corrects and strips that FEC before putting the frame
+ * on the wire, so an IPSC gateway only ever sees the 49 bits.
+ *
+ * Going 49 -> 72 -> 49 just to use the frame API would mean re-deriving FEC
+ * that is about to be discarded, and getting it exactly right for no benefit.
+ * These entry points skip it.
+ */
+
+/* 49 bits packed MSB-first and left-aligned: bit 48 lands in the top bit of
+   byte 6, and the remaining 7 bits of that byte are unused. */
+#define OPENDMR_AMBE49_BYTES 7
+
+/**
+ * Decode 49-bit voice parameters straight to PCM.
+ *
+ * @param dec    Decoder instance.
+ * @param bits49 Input parameters (7 bytes, left-aligned).
+ * @param pcm    Output PCM buffer (160 samples, 16-bit signed).
+ * @param errs   Optional: always 0 on this path, which carries no FEC.
+ *
+ * @return true on success, false on failure.
+ */
+bool opendmr_decode49(opendmr_decoder_t *dec,
+                      const uint8_t bits49[OPENDMR_AMBE49_BYTES],
+                      int16_t pcm[OPENDMR_PCM_SAMPLES],
+                      int *errs);
+
+/**
+ * Encode PCM to 49-bit voice parameters, without adding FEC.
+ *
+ * @param enc    Encoder instance.
+ * @param pcm    Input PCM buffer (160 samples, 16-bit signed, 8kHz).
+ * @param bits49 Output parameters (7 bytes, left-aligned).
+ *
+ * @return true on success, false on failure.
+ */
+bool opendmr_encode49(opendmr_encoder_t *enc,
+                      const int16_t pcm[OPENDMR_PCM_SAMPLES],
+                      uint8_t bits49[OPENDMR_AMBE49_BYTES]);
+
